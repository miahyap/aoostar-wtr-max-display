<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "aoostar-lcd">
<!ENTITY author    "miah.yap">
<!ENTITY version   "2026.11.17b">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" min="6.11.0" icon="aoostar-lcd.png" launch="Settings/AOOSTARLCD" pluginURL="https://raw.githubusercontent.com/miahyap/aoostar-wtr-max-display/main/unraid-plugin/aoostar-lcd.plg" support="https://github.com/miahyap/aoostar-wtr-max-display/issues">

<CHANGES>
###2026.11.17b
- Updating the plugin now restarts the display service, so a new version
  takes effect immediately instead of after the next reboot.

###2026.11.17a
- Redesigned panel for legibility on the real display: CPU, GPU,
  temperature and RAM as four large tiles; each network speed next to its
  arrow with its history graph and peak; a bottom strip with disk
  temperatures, array usage, IP address and clock. Pure black background,
  saturated colors, no text below 20 px.
- Fixed text placement: captions no longer straddle zone borders and an
  idle network graph no longer drops onto the row below.
- RAM is now colored by threshold; the disk alert names up to three disks.
- Note: a hand-customized monitor.json keeps working only for labels that
  still exist - several panel labels changed with this redesign.

###2026.11.17
- Network speeds now come from the kernel's own counters, so bridges and
  bonds (br0, bond0) work; the interface defaults to "auto" (the default
  route's interface). An unplugged or missing interface is named on the
  panel instead of showing "0 B/s".
- History sparklines use a square-root scale so light traffic stays
  visible next to a burst; speeds are shown as e.g. "13.8 MB/s".
- The collector's cost per cycle no longer grows with the graph window,
  and its loop no longer forks awk/cat.

###2026.07.21
- Add an optional daily on/off schedule: turn the display off and back
  on at configured times each day (cron drives the rc script's new
  sleep/wake verbs). Configured on the settings page.

###2026.07.18e
- Initial release: drive the AOOSTAR WTR MAX / GEM12+ PRO integrated
  display on Unraid using the open-source aoostar-rs driver (asterctl +
  aster-sysinfo). Includes settings page, sensor mapping generation and
  boot-time autostart.
</CHANGES>

<FILE Name="/usr/local/emhttp/plugins/aoostar-lcd/scripts/rc.aoostar-lcd" Mode="0755">
<SHA256>17bb20e000d9166e02e75224c591a441a099d9b8c2f35024d1ca4f7ce207fc7f</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash
# rc.aoostar-lcd - control script for the AOOSTAR WTR MAX / GEM12+ PRO
# integrated display driver on Unraid.
#
# Usage: rc.aoostar-lcd start|stop|restart|upgrade|status|install|sensors|on|off|sleep|wake|apply
#
# upgrade is what the plugin's install script runs: start, but replacing a
# service that is already running (see upgrade()).
#
# sleep/wake are the daily-schedule verbs driven by cron (see write_cron):
# sleep stops the service and powers the panel off; wake starts it again.
#
# Two daemons from the open-source aoostar-rs project (MIT/Apache-2.0):
#   aster-sysinfo  - collects system sensor values into a text file (tmpfs)
#   asterctl       - renders the sensor panel and drives the LCD over USB
#                    serial (USB UART 0416:90a1)
#
# Binaries live in RAM (/usr/local/aoostar-lcd), panel configuration
# persists on the flash drive. Nothing touches /mnt, so the service is
# independent of the array state.

PLUGIN="aoostar-lcd"
FLASH="/boot/config/plugins/$PLUGIN"
CFG="$FLASH/$PLUGIN.cfg"
APPDIR="/usr/local/aoostar-lcd"
CFGDIR="$FLASH/cfg"
RUNDIR="/run/aoostar-lcd"
LOGDIR="/var/log/aoostar-lcd"
CRONFILE="/etc/cron.d/aoostar-lcd"
GITHUB_RELEASE="https://api.github.com/repos/zehnm/aoostar-rs/releases/tags/latest"

# defaults (overridden by settings saved from the plugin page)
SERVICE="enabled"
NETIF="auto"
REFRESH="3"
DISKREFRESH="1800"
SMARTCTL="no"
CPU_TEMP_WARN="70"
CPU_TEMP_HOT="85"
HDD_HOT="45"
SSD_HOT="60"
CPU_TEMP_SENSOR="auto"
GRAPH_MIN="15"
SCHEDULE="disabled"
SCHED_OFF="23:00"
SCHED_ON="07:00"
[ -f "$CFG" ] && . "$CFG"

PIDFILE_SYS="/var/run/$PLUGIN-sysinfo.pid"
PIDFILE_CTL="/var/run/$PLUGIN-asterctl.pid"
PIDFILE_STATS="/var/run/$PLUGIN-stats.pid"
LOG_SYS="$LOGDIR/aster-sysinfo.log"
LOG_CTL="$LOGDIR/asterctl.log"
LOG_STATS="$LOGDIR/unraid-stats.log"
STATS="/usr/local/emhttp/plugins/$PLUGIN/scripts/unraid-stats.sh"

pid_running() {
  local pid
  pid=$(cat "$1" 2>/dev/null)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

proc_running() {
  # $1 = full command pattern to match
  pgrep -f "$1" >/dev/null 2>&1
}

running() {
  proc_running "$APPDIR/asterctl" || proc_running "$APPDIR/aster-sysinfo" || proc_running "$STATS"
}

rotate_log() {
  [ -f "$1" ] && [ "$(stat -c %s "$1" 2>/dev/null || echo 0)" -gt 2097152 ] && mv -f "$1" "$1.old"
}

daemonize() {
  # daemonize <pidfile> <logfile> <command...>
  # Detach stdio AND close every other inherited fd: when started from the
  # webgui (update.php / exec.php / plugin install), the caller's fd set
  # includes the web server's client socket - if the daemon keeps it open,
  # the browser request never completes (endless spinner).
  local pidfile="$1" logfile="$2" fd
  shift 2
  (
    exec </dev/null >>"$logfile" 2>&1
    for fd in /proc/self/fd/*; do
      fd=${fd##*/}
      [ "$fd" -gt 2 ] 2>/dev/null && eval "exec ${fd}>&-" 2>/dev/null
    done
    exec setsid "$@"
  ) &
  echo $! > "$pidfile"
}

install_pkg() {
  if [ -x "$APPDIR/asterctl" ] && [ -x "$APPDIR/aster-sysinfo" ]; then
    seed_cfg
    return 0
  fi
  mkdir -p "$FLASH/packages"
  local tarball
  tarball=$(ls -t "$FLASH"/packages/asterctl-*.tar.gz 2>/dev/null | head -1)
  if [ -z "$tarball" ]; then
    echo "No cached asterctl package found - downloading from GitHub ..."
    local url
    url=$(curl -s --max-time 30 "$GITHUB_RELEASE" \
          | grep -o '"browser_download_url": *"[^"]*Linux-x64[^"]*\.tar\.gz"' \
          | head -1 | cut -d'"' -f4)
    if [ -z "$url" ]; then
      echo "Error: could not determine download URL (no network?)."
      echo "Offline alternative: copy an asterctl release tarball to $FLASH/packages/"
      echo "from https://github.com/zehnm/aoostar-rs/releases"
      return 1
    fi
    local fname="${url##*/}"
    echo "Downloading $fname ..."
    if ! curl -sL --max-time 120 -o "$FLASH/packages/$fname" "$url"; then
      echo "Error: download failed."
      rm -f "$FLASH/packages/$fname"
      return 1
    fi
    # verify checksum published alongside the release (best effort)
    local hashurl="${url%/*}/asterctl.hash"
    if curl -sL --max-time 30 -o "$RUNDIR/asterctl.hash" "$hashurl" 2>/dev/null \
       && grep -q "$fname" "$RUNDIR/asterctl.hash"; then
      local want have
      want=$(grep "$fname" "$RUNDIR/asterctl.hash" | awk '{print $2}')
      have=$(sha256sum "$FLASH/packages/$fname" | awk '{print $1}')
      if [ "$want" != "$have" ]; then
        echo "Error: checksum mismatch for $fname - aborting."
        rm -f "$FLASH/packages/$fname"
        return 1
      fi
      echo "Checksum verified."
    else
      echo "Warning: could not verify checksum (hash file unavailable)."
    fi
    tarball="$FLASH/packages/$fname"
  fi
  echo "Installing $(basename "$tarball") to $APPDIR ..."
  mkdir -p "$APPDIR"
  if ! tar xzf "$tarball" -C "$APPDIR"; then
    echo "Error: extraction failed."
    return 1
  fi
  chmod +x "$APPDIR/asterctl" "$APPDIR/aster-sysinfo"
  # the upstream tarball ships no license file, but MIT requires the notice
  # to accompany the binaries - keep a copy beside them. $APPDIR is RAM and
  # is repopulated here on every boot, so this must live with the extraction
  # rather than in install.sh.
  cp -f "/usr/local/emhttp/plugins/$PLUGIN/LICENSE-asterctl.txt" \
        "$APPDIR/LICENSE-asterctl.txt" 2>/dev/null
  seed_cfg
}

seed_cfg() {
  # install the plugin's "Unraid Dark" panel into persistent flash storage.
  # The panel is (re)seeded when monitor.json is missing, still matches the
  # last seeded version (sha in .seeded), or is the untouched aoostar-rs
  # default - a user-customized panel is never overwritten.
  local panelsrc="/usr/local/emhttp/plugins/$PLUGIN/panel"
  mkdir -p "$CFGDIR"
  local seed="no" cur=""
  if [ ! -f "$CFGDIR/monitor.json" ]; then
    seed="yes"
  else
    cur=$(sha256sum "$CFGDIR/monitor.json" | awk '{print $1}')
    if [ -f "$CFGDIR/.seeded" ] && [ "$cur" = "$(cat "$CFGDIR/.seeded")" ]; then
      seed="yes"
    elif [ -f "$APPDIR/cfg/monitor.json" ] && cmp -s "$CFGDIR/monitor.json" "$APPDIR/cfg/monitor.json"; then
      seed="yes"
    fi
  fi
  if [ "$seed" = "yes" ] && [ -f "$panelsrc/monitor.json" ]; then
    if [ -z "$cur" ] || ! cmp -s "$panelsrc/monitor.json" "$CFGDIR/monitor.json"; then
      echo "Seeding Unraid Dark panel to $CFGDIR ..."
    fi
    cp "$panelsrc/monitor.json" "$panelsrc/unraid-dark.png" "$CFGDIR"/
    sha256sum "$CFGDIR/monitor.json" | awk '{print $1}' > "$CFGDIR/.seeded"
  fi
}

write_mapping() {
  # generate the sensor mapping unless the user manages it manually
  # (they opt out by removing the AUTO-GENERATED marker line)
  local map="$CFGDIR/sensor-mapping.cfg"
  local tpl="/usr/local/emhttp/plugins/$PLUGIN/sensor-mapping.template"
  if [ -f "$map" ] && ! grep -q '^# AUTO-GENERATED' "$map"; then
    return 0
  fi
  [ -f "$tpl" ] || return 0
  # the mapping needs a concrete interface name: resolve "auto" the same way
  # the collector does (the IPv4 default route's interface)
  local netif="$NETIF"
  if [ "$netif" = "auto" ]; then
    netif=$(ip -4 route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i + 1); exit}}')
    [ -z "$netif" ] && netif="br0"
  fi
  sed "s/@NETIF@/$netif/g" "$tpl" > "$map"
}

parse_hhmm() {
  # "HH:MM" (24h) -> "MM HH" for a crontab line; return non-zero on garbage.
  # Kept as one function so write_cron and its test assert on the same parse.
  local t="$1" h m
  [[ "$t" =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || return 1
  h=$((10#${BASH_REMATCH[1]})) ; m=$((10#${BASH_REMATCH[2]}))
  (( h >= 0 && h <= 23 && m >= 0 && m <= 59 )) || return 1
  printf '%d %d' "$m" "$h"
}

write_cron() {
  # (Re)install the daily display on/off cron. Called from start() (so a boot
  # re-establishes it, since /etc is tmpfs) and from apply. Always clears the
  # old file first, so disabling the schedule - or the whole service - removes
  # it. The two rc verbs the cron drives (sleep/wake) are defined below.
  rm -f "$CRONFILE"
  local off on
  if [ "$SERVICE" = "enabled" ] && [ "$SCHEDULE" = "enabled" ] \
     && off=$(parse_hhmm "$SCHED_OFF") && on=$(parse_hhmm "$SCHED_ON"); then
    {
      echo "# Generated by aoostar-lcd rc script - do not edit."
      echo "$off * * * /usr/local/emhttp/plugins/$PLUGIN/scripts/rc.aoostar-lcd sleep &>/dev/null"
      echo "$on * * * /usr/local/emhttp/plugins/$PLUGIN/scripts/rc.aoostar-lcd wake &>/dev/null"
    } > "$CRONFILE"
  fi
  # rebuild root's crontab from /etc/cron.d so the change (add or remove) takes
  # effect immediately, not only after the next reboot
  [ -x /usr/local/sbin/update_cron ] && /usr/local/sbin/update_cron 2>/dev/null
  return 0
}

start() {
  if [ "$SERVICE" != "enabled" ]; then
    echo "aoostar-lcd service is disabled in the plugin settings - not starting."
    return 0
  fi
  write_cron
  if running; then
    echo "aoostar-lcd is already running."
    return 0
  fi
  mkdir -p "$RUNDIR/sensors" "$LOGDIR"
  install_pkg || return 1
  write_mapping
  rotate_log "$LOG_SYS"
  rotate_log "$LOG_CTL"
  rotate_log "$LOG_STATS"

  if ! lsusb 2>/dev/null | grep -qi "0416:90a1"; then
    echo "Warning: LCD USB device 0416:90a1 not detected - asterctl may fail."
  fi

  cd "$APPDIR" || return 1
  export RUNDIR NETIF REFRESH CPU_TEMP_WARN CPU_TEMP_HOT HDD_HOT SSD_HOT CPU_TEMP_SENSOR GRAPH_MIN

  echo "Starting aster-sysinfo ..."
  local sysargs=(--out "$RUNDIR/sensors/sysinfo.txt" --temp-dir "$RUNDIR" --refresh "$REFRESH")
  [ "${DISKREFRESH:-0}" -gt 0 ] 2>/dev/null && sysargs+=(--disk-refresh "$DISKREFRESH")
  [ "$SMARTCTL" = "yes" ] && sysargs+=(--smartctl)
  daemonize "$PIDFILE_SYS" "$LOG_SYS" "$APPDIR/aster-sysinfo" "${sysargs[@]}"

  echo "Starting unraid-stats collector ..."
  daemonize "$PIDFILE_STATS" "$LOG_STATS" /bin/bash "$STATS"

  # give the collectors a moment to write the first sensor files
  sleep 2

  echo "Starting asterctl ..."
  daemonize "$PIDFILE_CTL" "$LOG_CTL" "$APPDIR/asterctl" \
      --config monitor.json \
      --config-dir "$CFGDIR" \
      --sensor-path "$RUNDIR/sensors" \
      --sensor-mapping sensor-mapping.cfg

  sleep 3
  if proc_running "$APPDIR/asterctl"; then
    echo "aoostar-lcd started - the display should now show the sensor panel."
  else
    echo "Error: asterctl exited. Last log lines:"
    tail -n 10 "$LOG_CTL" 2>/dev/null
    stop_proc "$APPDIR/aster-sysinfo" "$PIDFILE_SYS"
    stop_proc "$STATS" "$PIDFILE_STATS"
    return 1
  fi
}

stop_proc() {
  # $1 = full command pattern, $2 = pidfile
  local pattern="$1" pidfile="$2" pid i
  proc_running "$pattern" || { rm -f "$pidfile"; return 0; }
  pid=$(cat "$pidfile" 2>/dev/null)
  if [ -n "$pid" ]; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
  fi
  pkill -TERM -f "$pattern" 2>/dev/null
  for i in 1 2 3 4 5; do
    proc_running "$pattern" || break
    sleep 1
  done
  if proc_running "$pattern"; then
    pkill -KILL -f "$pattern" 2>/dev/null
    sleep 1
  fi
  rm -f "$pidfile"
}

stop() {
  echo "Stopping aoostar-lcd ..."
  stop_proc "$APPDIR/asterctl" "$PIDFILE_CTL"
  stop_proc "$STATS" "$PIDFILE_STATS"
  stop_proc "$APPDIR/aster-sysinfo" "$PIDFILE_SYS"
  echo "aoostar-lcd stopped."
}

upgrade() {
  # Run by install.sh at every plugin install - each boot AND each update.
  # At boot nothing is running and this is a plain start. On an update the
  # old daemons are still alive: bash has the previous collector script in
  # memory, and start() returns early at "already running" before seed_cfg
  # can install the new panel - so the update silently did nothing until the
  # next reboot. Stop first so the new files actually take effect.
  if running; then
    stop
  fi
  start
}

status() {
  local ok=1
  if proc_running "$APPDIR/aster-sysinfo"; then
    echo "aster-sysinfo: running (pid $(pgrep -f "$APPDIR/aster-sysinfo" | head -1))"
  else
    echo "aster-sysinfo: stopped"
  fi
  if proc_running "$STATS"; then
    echo "unraid-stats: running (pid $(pgrep -f "$STATS" | head -1))"
  else
    echo "unraid-stats: stopped"
  fi
  if proc_running "$APPDIR/asterctl"; then
    echo "asterctl: running (pid $(pgrep -f "$APPDIR/asterctl" | head -1))"
    ok=0
  else
    echo "asterctl: stopped"
  fi
  if lsusb 2>/dev/null | grep -qi "0416:90a1"; then
    echo "LCD USB device (0416:90a1): detected"
  else
    echo "LCD USB device (0416:90a1): NOT detected"
  fi
  return $ok
}

# tests source this file to exercise the functions above (parse_hhmm,
# write_cron) without dispatching a command
[ -n "${AOOSTAR_LCD_LIB:-}" ] && return 0

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    start
    ;;
  upgrade)
    upgrade
    ;;
  status)
    status
    ;;
  install)
    mkdir -p "$RUNDIR"
    install_pkg
    ;;
  sensors)
    # one-shot dump of all available sensor values (for mapping customization)
    if [ ! -x "$APPDIR/aster-sysinfo" ]; then
      echo "asterctl package not installed yet - click Start first."
      exit 1
    fi
    "$APPDIR/aster-sysinfo" --console 2>/dev/null
    ;;
  on|off)
    # direct display power control - only possible while asterctl is not
    # holding the serial port
    if proc_running "$APPDIR/asterctl"; then
      echo "Stop the service first: asterctl is using the serial port."
      exit 1
    fi
    if [ ! -x "$APPDIR/asterctl" ]; then
      echo "asterctl package not installed yet - click Start first."
      exit 1
    fi
    ( cd "$APPDIR" && "$APPDIR/asterctl" "--$1" 2>&1 )
    ;;
  sleep)
    # scheduled display-off: release the serial port, then power the panel off.
    # asterctl --off needs the port free, so the full service must stop first.
    stop
    if [ -x "$APPDIR/asterctl" ]; then
      ( cd "$APPDIR" && "$APPDIR/asterctl" --off 2>&1 )
    fi
    ;;
  wake)
    # scheduled display-on: (re)start the service, which powers the panel back
    # on. start() is a no-op when SERVICE is disabled.
    start
    ;;
  apply)
    # called after settings are saved
    stop
    write_cron
    [ "$SERVICE" = "enabled" ] && start
    ;;
  *)
    echo "Usage: $0 start|stop|restart|upgrade|status|install|sensors|on|off|sleep|wake|apply"
    exit 1
    ;;
esac
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/aoostar-lcd/scripts/unraid-stats.sh" Mode="0755">
<SHA256>7fce21cd6a4b6922798f07dc69d73828169b10337b70d850277a6e728cd76274</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash
# unraid-stats.sh - Unraid-specific sensor collector for the aoostar-lcd
# "Unraid Dark" panel.
#
# Reads aster-sysinfo's output (CPU, RAM, temperatures), the kernel's own
# network counters, and Unraid's disk state (/var/local/emhttp/disks.ini -
# temperatures cached by emhttp, so spun-down disks are NEVER woken) and
# writes panel-ready values to $RUNDIR/sensors/unraid.txt (atomic rename).
#
# Dynamic colors: each colored value has three label "slots" (_g/_a/_r);
# every slot is (re)written each cycle with only one non-empty - empty
# values render nothing, and overwriting is required because asterctl's
# sensor map never removes keys that disappear from the file.
#
# Network: speeds come from /sys/class/net/<if>/statistics, not from
# aster-sysinfo - that only reports physical NICs (no br0/bond0) and no
# address, so the Unraid default bridge showed nothing. NETIF=auto follows
# the default route. A missing or down interface is reported as such instead
# of a confident "0 B/s".
#
# Network history: samples are folded into GRAPH_BUCKETS time buckets as they
# arrive (per-bucket peak), so the cost per cycle is constant no matter how
# long the GRAPH_MIN window is. Rendered as block-element sparklines.
#
# The loop is deliberately fork-free apart from the final `mv`, the `sleep`
# and an occasional `ip` (see IP_EVERY): everything else is bash builtins.
#
# Configuration comes from the environment (set by rc.aoostar-lcd):
#   NETIF REFRESH CPU_TEMP_WARN CPU_TEMP_HOT HDD_HOT SSD_HOT
#   CPU_TEMP_SENSOR GRAPH_MIN

RUNDIR="${RUNDIR:-/run/aoostar-lcd}"
SYSINFO="${SYSINFO:-$RUNDIR/sensors/sysinfo.txt}"
OUT="${OUT:-$RUNDIR/sensors/unraid.txt}"
TMP="${TMP:-$RUNDIR/.unraid.txt.tmp}"
DISKS_INI="${DISKS_INI:-/var/local/emhttp/disks.ini}"
# kernel interfaces - overridable so tests can point at mock trees
SYS_NET="${SYS_NET:-/sys/class/net}"
SYS_BLOCK="${SYS_BLOCK:-/sys/block}"
SYS_HWMON="${SYS_HWMON:-/sys/class/hwmon}"
SYS_DRM="${SYS_DRM:-/sys/class/drm}"
PROC_ROUTE="${PROC_ROUTE:-/proc/net/route}"
PROC_UPTIME="${PROC_UPTIME:-/proc/uptime}"

NETIF="${NETIF:-auto}"
REFRESH="${REFRESH:-3}"
CPU_TEMP_WARN="${CPU_TEMP_WARN:-70}"
CPU_TEMP_HOT="${CPU_TEMP_HOT:-85}"
UTIL_WARN="${UTIL_WARN:-70}"
UTIL_HOT="${UTIL_HOT:-90}"
MEM_WARN="${MEM_WARN:-80}"
MEM_HOT="${MEM_HOT:-92}"
HDD_HOT="${HDD_HOT:-45}"
SSD_HOT="${SSD_HOT:-60}"
CPU_TEMP_SENSOR="${CPU_TEMP_SENSOR:-auto}"
GRAPH_MIN="${GRAPH_MIN:-15}"

# number of sparkline columns - make_panel.py reads this to check that the
# graph fits its slot at the panel's font size
GRAPH_BUCKETS=14
LEVELS=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)
# Every sparkline starts with this full-height, one-eighth-wide glyph (it
# reads as the graph's y-axis). asterctl positions a string by its TALLEST
# glyph, so without a constant full-height glyph an all-baseline sparkline
# (idle link) renders 0.7 x the font size lower than a busy one - on the
# first panel it dropped onto the download speed below it.
SPARK_AXIS="▏"
# at most this many hot disks are named in the alert; the rest are counted
ALERT_MAX=3
# the address rarely changes and reading it costs a fork: refresh it only
# every IP_EVERY cycles (and whenever the interface changes)
IP_EVERY=20

# ------------------------------------------------------------------- helpers

# now_cs: sets NOW_CS to a monotonic clock in centiseconds. /proc/uptime is
# read with a builtin (no fork) and is immune to NTP/timezone jumps.
now_cs() {
  local up=0
  { read -r up _ < "$PROC_UPTIME"; } 2>/dev/null
  NOW_CS=$(( 10#${up/./} ))
}

# readf <file>: sets REPLY to the first line of a file ("" if unreadable)
# without forking `cat`.
readf() {
  REPLY=""
  { read -r REPLY < "$1"; } 2>/dev/null
  return 0
}

# humanize <bytes/s>: sets HUMAN to a short fixed-shape string such as
# "13.8 MB/s" - one decimal below 100, none above, so the value does not
# jitter between widths. Integer maths only.
humanize() {
  local v=$1 d=1 i=0 tenths
  local units=(B KB MB GB TB)
  while (( v >= d * 1024 && i < 4 )); do
    d=$(( d * 1024 )); i=$(( i + 1 ))
  done
  if (( i == 0 )); then
    HUMAN="$v B/s"
    return
  fi
  tenths=$(( (v * 10 + d / 2) / d ))
  if (( tenths >= 1000 )); then
    HUMAN="$(( (tenths + 5) / 10 )) ${units[i]}/s"
  else
    HUMAN="$(( tenths / 10 )).$(( tenths % 10 )) ${units[i]}/s"
  fi
}

# slot: <label> <value> <warn> <hot> <suffix>
# Emits ALL three color slots every cycle - the active one with the
# formatted value, the others empty. asterctl's sensor map accumulates
# keys (absent keys are never removed), so an empty overwrite is the only
# way to clear a previously used slot; empty values render nothing.
slot() {
  local label="$1" value="$2" warn="$3" hot="$4" suffix="$5" int active="g"
  if [ -n "$value" ]; then
    int=${value%%.*}
    if [ "$int" -ge "$hot" ] 2>/dev/null; then
      active="r"
    elif [ "$int" -ge "$warn" ] 2>/dev/null; then
      active="a"
    fi
  fi
  local c
  for c in g a r; do
    if [ "$c" = "$active" ] && [ -n "$value" ]; then
      echo "${label}_${c}: ${value}${suffix}"
    else
      echo "${label}_${c}:"
    fi
  done
}

# ------------------------------------------------------------ sysinfo values

# read aster-sysinfo's "key: value" file into S[]
declare -A S
read_sysinfo() {
  local key val
  S=()
  [ -f "$SYSINFO" ] || return 0
  while IFS=: read -r key val; do
    # the file has ~200 lines and the panel needs a handful: skip the rest
    # before doing any string work (this loop dominated the cycle time)
    case "$key" in
      cpu_usage_percent|mem_usage_percent|temperature_*|"$CPU_TEMP_SENSOR") ;;
      *) continue ;;
    esac
    # "key: value" - strip the separator space; the full (slow) trim only
    # runs for the rare value that still has surrounding whitespace
    val=${val# }
    case "$val" in
      [[:space:]]*|*[[:space:]])
        val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}" ;;
    esac
    S[$key]="$val"
  done < "$SYSINFO"
}

cpu_temp_from_hwmon() {
  # fallback: read k10temp (AMD) / coretemp (Intel) directly from sysfs
  local hw
  CPUTEMP=""
  for hw in "$SYS_HWMON"/hwmon*; do
    readf "$hw/name"
    case "$REPLY" in
      k10temp|coretemp|zenpower)
        readf "$hw/temp1_input"
        [ -n "$REPLY" ] && CPUTEMP=$(( REPLY / 1000 )) && return
        ;;
    esac
  done
}

# sets CPUTEMP
read_cpu_temp() {
  local k
  CPUTEMP=""
  if [ "$CPU_TEMP_SENSOR" != "auto" ]; then
    CPUTEMP="${S[$CPU_TEMP_SENSOR]}"
    return
  fi
  for k in temperature_cpu temperature_k10temp_Tctl temperature_k10temp \
           temperature_Tctl temperature_coretemp_Package_id_0; do
    [ -n "${S[$k]}" ] && CPUTEMP="${S[$k]}" && return
  done
  for k in "${!S[@]}"; do
    case "$k" in
      temperature_*k10temp*|temperature_*coretemp*|temperature_*Tctl*)
        [ "${k%"#unit"}" = "$k" ] && CPUTEMP="${S[$k]}" && return ;;
    esac
  done
  cpu_temp_from_hwmon
}

# sets GPUUTIL (amdgpu iGPU, same die as the CPU)
read_gpu_util() {
  local f
  GPUUTIL=""
  for f in "$SYS_DRM"/card*/device/gpu_busy_percent; do
    [ -f "$f" ] || continue
    readf "$f"
    GPUUTIL=$REPLY
    return
  done
}

# ------------------------------------------------------------------- network

# resolve_netif: sets IFACE. NETIF=auto follows the IPv4 default route
# (lowest metric wins), which is the interface that actually carries the
# server's traffic - br0 on a stock Unraid, bond0/eth0 without bridging.
resolve_netif() {
  local ifc dest gw flags ref use metric mask rest best=""
  if [ "$NETIF" != "auto" ]; then
    IFACE=$NETIF
    return
  fi
  IFACE=""
  [ -r "$PROC_ROUTE" ] || return 0
  while read -r ifc dest gw flags ref use metric mask rest; do
    [ "$dest" = "00000000" ] && [ "$mask" = "00000000" ] || continue
    if [ -z "$best" ] || (( metric < best )); then
      best=$metric
      IFACE=$ifc
    fi
  done < "$PROC_ROUTE"
}

# iface_ip <if>: sets NET_IP to the interface's first IPv4 address ("" if
# none). The only fork in the network path - see IP_EVERY.
iface_ip() {
  local line addr
  NET_IP=""
  line=$(ip -4 -o addr show dev "$1" 2>/dev/null) || return 0
  # "5: br0    inet 192.168.57.10/24 brd 192.168.57.255 scope global br0"
  read -r _ _ _ addr _ <<< "$line"
  NET_IP=${addr%/*}
}

# net_sample: sets NET_STATE ("ok" or a human-readable problem), and
# NET_UP / NET_DOWN in bytes/s from the counter deltas since the last call.
# The first sample after a (re)start or interface change reports 0.
PREV_IF="" PREV_CS=0 PREV_RX=0 PREV_TX=0
net_sample() {
  local dir="$SYS_NET/$IFACE" rx tx dt
  NET_UP=0 NET_DOWN=0
  if [ -z "$IFACE" ]; then
    NET_STATE="no default route"; PREV_IF=""; return
  fi
  if [ ! -d "$dir" ]; then
    NET_STATE="$IFACE not found"; PREV_IF=""; return
  fi
  readf "$dir/operstate"
  case "$REPLY" in
    down|lowerlayerdown|notpresent)
      NET_STATE="$IFACE link down"; PREV_IF=""; return ;;
  esac
  readf "$dir/statistics/rx_bytes"; rx=${REPLY:-0}
  readf "$dir/statistics/tx_bytes"; tx=${REPLY:-0}
  # counters going backwards = interface was recreated: skip this delta
  if [ "$PREV_IF" = "$IFACE" ] \
     && (( NOW_CS > PREV_CS && rx >= PREV_RX && tx >= PREV_TX )); then
    dt=$(( NOW_CS - PREV_CS ))
    NET_DOWN=$(( (rx - PREV_RX) * 100 / dt ))
    NET_UP=$(( (tx - PREV_TX) * 100 / dt ))
  fi
  PREV_IF=$IFACE PREV_CS=$NOW_CS PREV_RX=$rx PREV_TX=$tx
  NET_STATE="ok"
}

# ----------------------------------------------------------- network history

# Fixed-size bucket arrays: index GRAPH_BUCKETS-1 is the bucket currently
# being filled, older buckets shift left. Each holds the peak bytes/s seen
# during its BUCKET_CS slice of the window.
hist_init() {
  local i
  BUCKET_CS=$(( GRAPH_MIN * 6000 / GRAPH_BUCKETS ))
  # a bucket shorter than the sample interval would stay empty between samples
  (( BUCKET_CS < REFRESH * 100 )) && BUCKET_CS=$(( REFRESH * 100 ))
  UP_B=() DOWN_B=()
  for (( i = 0; i < GRAPH_BUCKETS; i++ )); do
    UP_B+=(0); DOWN_B+=(0)
  done
  BUCKET_T=""
}

# hist_push <up> <down>: fold one sample into the current bucket, first
# advancing the window to NOW_CS. O(GRAPH_BUCKETS) at worst, never O(samples).
hist_push() {
  local up=$1 down=$2 last=$(( GRAPH_BUCKETS - 1 )) steps
  [ -z "$BUCKET_T" ] && BUCKET_T=$NOW_CS
  steps=$(( (NOW_CS - BUCKET_T) / BUCKET_CS ))
  if (( steps >= GRAPH_BUCKETS )); then
    # nothing recorded for a whole window (e.g. the box was suspended)
    hist_init
    BUCKET_T=$NOW_CS
  else
    while (( steps-- > 0 )); do
      UP_B=("${UP_B[@]:1}" 0)
      DOWN_B=("${DOWN_B[@]:1}" 0)
      BUCKET_T=$(( BUCKET_T + BUCKET_CS ))
    done
  fi
  (( up > UP_B[last] )) && UP_B[last]=$up
  (( down > DOWN_B[last] )) && DOWN_B[last]=$down
  return 0
}

# spark_level <value> <max>: sets LEVEL (index into LEVELS).
# Square-root scale: with a linear one a single burst flattens everything
# else to the baseline. Any non-zero traffic gets at least level 1, so
# "idle" and "some traffic" stay distinguishable next to a large peak.
spark_level() {
  local v=$1 max=$2 l=0
  LEVEL=0
  (( v <= 0 || max <= 0 )) && return 0
  # largest l in 0..7 with (l/7)^2 <= v/max
  while (( l < 7 && (l + 1) * (l + 1) * max <= 49 * v )); do
    l=$(( l + 1 ))
  done
  (( l < 1 )) && l=1
  LEVEL=$l
}

# sparkline <bucket-array-name>: sets SPARK (SPARK_AXIS + GRAPH_BUCKETS block
# chars) and PEAK (window max, bytes/s)
sparkline() {
  local -n _arr=$1
  local v max=0
  for v in "${_arr[@]}"; do
    (( v > max )) && max=$v
  done
  PEAK=$max
  SPARK=$SPARK_AXIS
  for v in "${_arr[@]}"; do
    spark_level "$v" "$max"
    SPARK+="${LEVELS[LEVEL]}"
  done
}

# --------------------------------------------------------------------- disks

declare -A ROT_CACHE
# is_ssd <device> <rotational-from-disks.ini>: true for non-rotational media.
# disks.ini carries the flag on current Unraid; older releases need sysfs,
# which is read once per device and cached (it never changes).
is_ssd() {
  local dev=$1 rot=$2
  case "$dev" in nvme*) return 0 ;; esac
  if [ -z "$rot" ]; then
    if [ -z "${ROT_CACHE[$dev]+x}" ]; then
      readf "$SYS_BLOCK/$dev/queue/rotational"
      ROT_CACHE[$dev]=${REPLY:-1}
    fi
    rot=${ROT_CACHE[$dev]}
  fi
  [ "$rot" = "0" ]
}

flush_disk() {
  local limit
  [ -z "$d_dev" ] && return
  case "$d_name" in flash|"") d_dev=""; return ;; esac
  # array capacity: data disks only (parity has no filesystem, pools are
  # separate). Sizes are emhttp's cached numbers, so standby disks count
  # without being woken.
  if [ "$d_type" = "Data" ] && [ "$d_size" -gt 0 ] 2>/dev/null; then
    arr_size=$(( arr_size + d_size ))
    arr_used=$(( arr_used + ${d_used:-0} ))
  fi
  if [ "$d_temp" = "*" ] || [ -z "$d_temp" ]; then
    standby=$(( standby + 1 )); d_dev=""; return
  fi
  if is_ssd "$d_dev" "$d_rot"; then
    ssd_n=$(( ssd_n + 1 )); [ "$d_temp" -gt "$ssd_max" ] && ssd_max=$d_temp
    limit=$SSD_HOT
  else
    hdd_n=$(( hdd_n + 1 )); [ "$d_temp" -gt "$hdd_max" ] && hdd_max=$d_temp
    limit=$HDD_HOT
  fi
  if [ "$d_temp" -ge "$limit" ] 2>/dev/null; then
    hot_n=$(( hot_n + 1 ))
    (( hot_n <= ALERT_MAX )) && hot_list="$hot_list, $d_name ${d_temp}°C"
  fi
  d_dev=""
}

# temperatures and sizes from emhttp's cache (never wakes disks); sets
# hdd_max ssd_max hdd_n ssd_n standby hot_list hot_n arr_size arr_used
read_disks() {
  local line
  hdd_max=0 ssd_max=0 hdd_n=0 ssd_n=0 standby=0 hot_list="" hot_n=0
  arr_size=0 arr_used=0
  d_name="" d_dev="" d_temp="" d_rot="" d_type="" d_size="" d_used=""
  [ -f "$DISKS_INI" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      \[*\])   flush_disk; d_name="${line#[\"}"; d_name="${d_name%\"]}"
               d_name="${d_name#[}"; d_name="${d_name%]}"
               d_dev="" d_temp="" d_rot="" d_type="" d_size="" d_used="" ;;
      device=*)     d_dev="${line#device=}"; d_dev="${d_dev//\"/}" ;;
      temp=*)       d_temp="${line#temp=}"; d_temp="${d_temp//\"/}" ;;
      rotational=*) d_rot="${line#rotational=}"; d_rot="${d_rot//\"/}" ;;
      type=*)       d_type="${line#type=}"; d_type="${d_type//\"/}" ;;
      fsSize=*)     d_size="${line#fsSize=}"; d_size="${d_size//\"/}" ;;
      fsUsed=*)     d_used="${line#fsUsed=}"; d_used="${d_used//\"/}" ;;
    esac
  done < "$DISKS_INI"
  flush_disk
  hot_list="${hot_list#, }"
  (( hot_n > ALERT_MAX )) && hot_list="$hot_list +$(( hot_n - ALERT_MAX ))"
  return 0
}

# -------------------------------------------------------------------- output

write_panel() {
  local summary window
  echo "# generated by unraid-stats.sh"
  # static captions (rendered by asterctl as plain text sensors)
  echo "lbl_cpu: CPU"
  echo "lbl_gpu: GPU"
  echo "lbl_temp: TEMP"
  echo "lbl_ram: RAM"
  echo "lbl_up: ▲"
  echo "lbl_down: ▼"
  if (( GRAPH_MIN >= 120 && GRAPH_MIN % 60 == 0 )); then
    window="$(( GRAPH_MIN / 60 )) h"
  else
    window="${GRAPH_MIN} min"
  fi
  echo "lbl_peak: $window peak"

  slot cpu_util "${S[cpu_usage_percent]%%.*}" "$UTIL_WARN" "$UTIL_HOT" "%"
  slot gpu_util "${GPUUTIL%%.*}" "$UTIL_WARN" "$UTIL_HOT" "%"
  slot cpu_temp "${CPUTEMP%%.*}" "$CPU_TEMP_WARN" "$CPU_TEMP_HOT" "°C"
  slot mem_pct "${S[mem_usage_percent]%%.*}" "$MEM_WARN" "$MEM_HOT" "%"

  # always write every key so an interface change can never leave stale
  # values. A broken interface shows "n/a" plus its problem instead of
  # "0 B/s", which is indistinguishable from an idle link. ("n/a" rather
  # than dashes: asterctl positions text by its tallest glyph, and the "/"
  # keeps these on the same baseline as "13.8 MB/s".)
  if [ "$NET_STATE" = "ok" ]; then
    humanize "$NET_UP";   echo "net_up: $HUMAN"
    humanize "$NET_DOWN"; echo "net_down: $HUMAN"
    NET_NOTE="${NET_IP:-no IPv4 on $IFACE}"
  else
    echo "net_up: n/a"
    echo "net_down: n/a"
    NET_NOTE="$NET_STATE"
  fi

  sparkline UP_B
  humanize "$PEAK"
  echo "net_up_graph: $SPARK"
  echo "net_up_peak: $HUMAN"
  sparkline DOWN_B
  humanize "$PEAK"
  echo "net_down_graph: $SPARK"
  echo "net_down_peak: $HUMAN"

  # always write both disk keys: one empty, to clear the stale counterpart
  if [ -n "$hot_list" ]; then
    echo "disk_alert: ⚠ HOT: $hot_list"
    echo "disk_ok:"
    # the alert can need the strip's full width: it outranks the address
    echo "net_ip:"
  else
    summary=""
    [ "$hdd_n" -gt 0 ] && summary="HDD ${hdd_max}°C"
    [ "$ssd_n" -gt 0 ] && summary="${summary:+$summary · }SSD ${ssd_max}°C"
    [ "$standby" -gt 0 ] && summary="${summary:+$summary · }$standby standby"
    [ "$arr_size" -gt 0 ] && summary="${summary:+$summary · }Array $(( arr_used * 100 / arr_size ))%"
    echo "disk_ok: ${summary:-disks: no data}"
    echo "disk_alert:"
    echo "net_ip: $NET_NOTE"
  fi
}

# one full collection cycle: gather everything, then publish atomically
CYCLE=0 IP_IF=""
collect_once() {
  now_cs
  read_sysinfo
  read_cpu_temp
  read_gpu_util

  resolve_netif
  net_sample
  if [ "$NET_STATE" = "ok" ]; then
    if [ "$IFACE" != "$IP_IF" ] || (( CYCLE % IP_EVERY == 0 )); then
      iface_ip "$IFACE"
      IP_IF=$IFACE
    fi
  else
    IP_IF=""
  fi
  hist_push "$NET_UP" "$NET_DOWN"

  read_disks

  write_panel > "$TMP"
  mv -f "$TMP" "$OUT"
  CYCLE=$(( CYCLE + 1 ))
}

hist_init

# tests source this file to exercise the functions above without starting
# the collection loop
[ -n "${AOOSTAR_LCD_LIB:-}" ] && return 0

while :; do
  collect_once
  sleep "$REFRESH"
done
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/aoostar-lcd/AOOSTARLCD.page" Mode="0644">
<SHA256>6e24d128b559039f2bbdc399b393e7f9e3bc16a6c6e0bb07e1c7af9d59936f32</SHA256>
<INLINE>
<![CDATA[
Menu="Utilities"
Title="AOOSTAR LCD"
Icon="aoostar-lcd.png"
Markdown="true"
---
<?PHP
/* AOOSTAR WTR MAX / GEM12+ PRO integrated display - plugin settings page */
$alcd_defaults = [
  'SERVICE'       => 'enabled',
  'NETIF'         => 'auto',
  'REFRESH'       => '3',
  'DISKREFRESH'   => '1800',
  'SMARTCTL'      => 'no',
  'CPU_TEMP_WARN' => '70',
  'CPU_TEMP_HOT'  => '85',
  'HDD_HOT'       => '45',
  'SSD_HOT'       => '60',
  'GRAPH_MIN'     => '15',
  'SCHEDULE'      => 'disabled',
  'SCHED_OFF'     => '23:00',
  'SCHED_ON'      => '07:00',
];
$alcd_flash_cfg = '/boot/config/plugins/aoostar-lcd/aoostar-lcd.cfg';
$alcd_cfg = $alcd_defaults;
if (file_exists($alcd_flash_cfg)) {
  $ini = parse_ini_file($alcd_flash_cfg);
  if (is_array($ini)) $alcd_cfg = array_replace($alcd_cfg, $ini);
}

$alcd_ctl_running = !empty(exec("pgrep -f /usr/local/aoostar-lcd/asterctl 2>/dev/null"));
$alcd_sys_running = !empty(exec("pgrep -f /usr/local/aoostar-lcd/aster-sysinfo 2>/dev/null"));
$alcd_usb = !empty(exec("lsusb 2>/dev/null | grep -i '0416:90a1'"));
$alcd_installed = file_exists('/usr/local/aoostar-lcd/asterctl');
$alcd_running = $alcd_ctl_running;

function alcd_dot($ok, $labelOk, $labelBad) {
  return $ok
    ? "<span style='color:green;font-weight:bold'>$labelOk</span>"
    : "<span style='color:#d00;font-weight:bold'>$labelBad</span>";
}

/* available network interfaces (with IPv4 address when assigned) */
$alcd_ifaces = [];
foreach (scandir('/sys/class/net') ?: [] as $if) {
  if ($if === '.' || $if === '..' || $if === 'lo') continue;
  $alcd_ifaces[$if] = '';
}
exec('ip -4 -o addr show 2>/dev/null', $alcd_addr_lines);
foreach ($alcd_addr_lines as $line) {
  $parts = preg_split('/\s+/', trim($line));
  if (isset($parts[1], $parts[3]) && array_key_exists($parts[1], $alcd_ifaces)) {
    $alcd_ifaces[$parts[1]] = explode('/', $parts[3])[0];
  }
}
if ($alcd_cfg['NETIF'] !== 'auto' && !array_key_exists($alcd_cfg['NETIF'], $alcd_ifaces)) {
  $alcd_ifaces[$alcd_cfg['NETIF']] = '';
}
ksort($alcd_ifaces);

$alcd_logtail = '';
$alcd_logfile = '/var/log/aoostar-lcd/asterctl.log';
if (file_exists($alcd_logfile)) {
  $lines = @file($alcd_logfile);
  if (is_array($lines)) $alcd_logtail .= "--- asterctl.log ---\n" . implode('', array_slice($lines, -15));
}
$alcd_syslogfile = '/var/log/aoostar-lcd/aster-sysinfo.log';
if (file_exists($alcd_syslogfile)) {
  $lines = @file($alcd_syslogfile);
  if (is_array($lines)) $alcd_logtail .= "\n--- aster-sysinfo.log ---\n" . implode('', array_slice($lines, -10));
}
?>

**Display driver:** <?=alcd_dot($alcd_ctl_running,'Running','Stopped')?> &nbsp;|&nbsp;
**Sensor collector:** <?=alcd_dot($alcd_sys_running,'Running','Stopped')?> &nbsp;|&nbsp;
**LCD USB device (0416:90a1):** <?=alcd_dot($alcd_usb,'Detected','Not found')?>

<input type="button" value="Start" onclick="alcdCmd('start')" <?=$alcd_running?'disabled':''?>>
<input type="button" value="Stop" onclick="alcdCmd('stop')" <?=$alcd_running?'':'disabled'?>>
<input type="button" value="Restart" onclick="alcdCmd('restart')" <?=$alcd_running?'':'disabled'?>>
&nbsp;&nbsp;
<input type="button" value="Display On" onclick="alcdCmd('on')" <?=$alcd_running?'disabled':''?>>
<input type="button" value="Display Off" onclick="alcdCmd('off')" <?=$alcd_running?'disabled':''?>>
&nbsp;&nbsp;
<input type="button" value="Show available sensors" onclick="alcdCmd('sensors')" <?=$alcd_installed?'':'disabled'?>>

<?if (!$alcd_usb):?>
<div style="border:1px solid #e68a00;background:rgba(230,138,0,0.1);padding:10px;margin:8px 0">
<b>Note:</b> the display's USB serial device was not detected. On a WTR MAX it
should appear in <code>lsusb</code> as ID <code>0416:90a1</code>. Check that the
internal display cable/USB header is connected.
</div>
<?endif;?>

<form markdown="1" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="aoostar-lcd/aoostar-lcd.cfg">
<input type="hidden" name="#command" value="/usr/local/emhttp/plugins/aoostar-lcd/scripts/rc.aoostar-lcd">
<input type="hidden" name="#arg[1]" value="apply">

Start automatically at boot:
: <select name="SERVICE">
  <option value="enabled" <?=$alcd_cfg['SERVICE']=='enabled'?'selected':''?>>Yes</option>
  <option value="disabled" <?=$alcd_cfg['SERVICE']=='disabled'?'selected':''?>>No</option>
  </select>

Turn the display off and back on automatically each day:
: <select name="SCHEDULE">
  <option value="disabled" <?=$alcd_cfg['SCHEDULE']=='disabled'?'selected':''?>>No</option>
  <option value="enabled" <?=$alcd_cfg['SCHEDULE']=='enabled'?'selected':''?>>Yes</option>
  </select>

&nbsp;&nbsp;&bull; turn the display off at:
: <input type="time" name="SCHED_OFF" value="<?=htmlspecialchars($alcd_cfg['SCHED_OFF'])?>">

&nbsp;&nbsp;&bull; turn the display back on at:
: <input type="time" name="SCHED_ON" value="<?=htmlspecialchars($alcd_cfg['SCHED_ON'])?>">

Network interface shown on the display:
: <select name="NETIF">
  <option value="auto" <?=$alcd_cfg['NETIF']=='auto'?'selected':''?>>auto (interface of the default route)</option>
<?foreach ($alcd_ifaces as $if => $ip):?>
  <option value="<?=htmlspecialchars($if)?>" <?=$alcd_cfg['NETIF']==$if?'selected':''?>><?=htmlspecialchars($if.($ip ? " ($ip)" : ''))?></option>
<?endforeach;?>
  </select>

Network graph time window (minutes):
: <input type="number" name="GRAPH_MIN" min="1" max="1440" value="<?=htmlspecialchars($alcd_cfg['GRAPH_MIN'])?>">

Sensor refresh interval (seconds):
: <input type="number" name="REFRESH" min="1" max="60" value="<?=htmlspecialchars($alcd_cfg['REFRESH'])?>">

Disk usage refresh interval (seconds, 0 = disabled):
: <input type="number" name="DISKREFRESH" min="0" max="86400" value="<?=htmlspecialchars($alcd_cfg['DISKREFRESH'])?>">

Read disk temperatures with smartctl (can wake spun-down disks!):
: <select name="SMARTCTL">
  <option value="no" <?=$alcd_cfg['SMARTCTL']=='no'?'selected':''?>>No</option>
  <option value="yes" <?=$alcd_cfg['SMARTCTL']=='yes'?'selected':''?>>Yes</option>
  </select>

CPU/GPU temperature: turn amber at (&deg;C):
: <input type="number" name="CPU_TEMP_WARN" min="30" max="110" value="<?=htmlspecialchars($alcd_cfg['CPU_TEMP_WARN'])?>">

CPU/GPU temperature: turn red at (&deg;C):
: <input type="number" name="CPU_TEMP_HOT" min="30" max="110" value="<?=htmlspecialchars($alcd_cfg['CPU_TEMP_HOT'])?>">

HDD temperature alert threshold (&deg;C):
: <input type="number" name="HDD_HOT" min="30" max="70" value="<?=htmlspecialchars($alcd_cfg['HDD_HOT'])?>">

SSD/NVMe temperature alert threshold (&deg;C):
: <input type="number" name="SSD_HOT" min="30" max="90" value="<?=htmlspecialchars($alcd_cfg['SSD_HOT'])?>">

<input type="submit" value="Apply">
<input type="button" value="Done" onclick="done()">
</form>

**Notes**

* The **daily on/off schedule** turns the panel off at the *off* time and back on at the *on* time (24-hour clock, server local time). While off, the driver is fully stopped to release the display, so the status above reads *Stopped* during the off window - this is expected. A manual *Start* wakes it early; the next scheduled off-time still applies. The schedule only runs when *Start automatically at boot* is set to Yes.
* **Network interface**: *auto* follows the default route (`br0` on a stock Unraid). If the chosen interface is unplugged or missing, the panel says so (e.g. `eth3 link down`) instead of showing `0 B/s`.
* The bundled **Unraid Dark** panel shows CPU, GPU, die temperature and RAM as four large tiles (green/amber/red; temperature by the thresholds above), network up/down speeds with history graphs and window peaks, and a strip along the bottom with a green disk summary (hottest HDD/SSD, standby count, array usage), the IP address and a clock. The summary switches to a red alert naming any disk at/over its threshold. Disk temperatures come from Unraid itself, so spun-down disks are never woken.
* Panel layout lives in `/boot/config/plugins/aoostar-lcd/cfg/monitor.json` (AOOSTAR-X theme format, incl. background images) — edit it and restart the driver to change what the display shows. If you customize it, the plugin stops touching it; delete it to get the stock panel back on next start.
* Sensor name mapping: `/boot/config/plugins/aoostar-lcd/cfg/sensor-mapping.cfg`. It is auto-generated from your settings; delete its first line to manage it manually (use *Show available sensors* to see what your hardware provides).
* Extra motherboard sensors (fan RPM etc.) need the it87 kernel driver: install **"IT87 Driver"** (by ich777) from the *Apps* tab.
* Driver engine: open-source [aoostar-rs](https://github.com/zehnm/aoostar-rs) (`asterctl`), reverse-engineered — no vendor software required. Licensed under MIT; the full text is installed alongside the binaries at `/usr/local/aoostar-lcd/LICENSE-asterctl.txt`. This plugin's own code is MIT too.

**Recent log**

<pre style="max-height:300px;overflow:auto"><?=htmlspecialchars($alcd_logtail ?: '(no log yet)')?></pre>

<script>
function alcdCmd(cmd) {
  $.post('/plugins/aoostar-lcd/include/exec.php', {cmd: cmd}, function(data) {
    swal({title: 'aoostar-lcd: ' + cmd, text: '<pre style="text-align:left;max-height:400px;overflow:auto">' + data.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</pre>', type: 'info', html: true},
         function(){ if (cmd != 'sensors' && cmd != 'status') location.reload(); });
  }).fail(function() {
    swal('aoostar-lcd', 'Command failed', 'error');
  });
}
</script>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/aoostar-lcd/include/exec.php" Mode="0644">
<SHA256>fffd2b7ddc5e375836d0c3d886e4e8731d25e7485d42049f388e6cf345e728d2</SHA256>
<INLINE>
<![CDATA[
<?php
/* Button backend for the aoostar-lcd plugin settings page.
 * Served by the Unraid webgui (behind its authentication). Only a fixed
 * whitelist of rc-script actions can be invoked. */
$allowed = ['start', 'stop', 'restart', 'status', 'install', 'sensors', 'on', 'off'];
$cmd = $_POST['cmd'] ?? '';
if (!in_array($cmd, $allowed, true)) {
  http_response_code(400);
  exit('invalid command');
}
header('Content-Type: text/plain; charset=utf-8');
passthru('/usr/local/emhttp/plugins/aoostar-lcd/scripts/rc.aoostar-lcd ' . escapeshellarg($cmd) . ' 2>&1');
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/aoostar-lcd/sensor-mapping.template" Mode="0644">
<SHA256>cc6d2ce83b4294f8a0c59ba01f59b37616170ff0fe9a870f4810fe2cd19ea604</SHA256>
<INLINE>
<![CDATA[
# AUTO-GENERATED by the aoostar-lcd plugin - edits will be overwritten!
# To manage this file manually, delete the AUTO-GENERATED line above.
#
# Maps sensor labels used in the panel definition (monitor.json, left side)
# to sensor labels produced by aster-sysinfo (right side).
# Run "Show available sensors" on the plugin settings page to list every
# sensor label your system provides.

cpu_percent: cpu_usage_percent
cpu_temperature: temperature_cpu
memory_usage: mem_usage_percent
memory_Temperature: temperature_memory
gpu_temperature: temperature_gpu

net_upload_speed: network_@NETIF@_upload_speed
net_download_speed: network_@NETIF@_download_speed
net_ip_address: network_@NETIF@_address0

# Per-disk mappings are system specific - examples (uncomment and adapt
# after checking "Show available sensors"):
#storage_ssd[0]['used']: storage_ssd[0]_usage_percent
#storage_ssd[0]['temperature']: temperature_nvme_Composite_YOUR_NVME_MODEL
#storage_hdd[0]['used']: storage_hdd[0]_usage_percent
]]>
</INLINE>
</FILE>

